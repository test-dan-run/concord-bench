# Copy to .env. Every setting has a default; see backend/concord_bench/core/settings.py.
# CONCORD_DATA=./data                 # audio, derived files and concord.db (local disk)
# PLATFORM_DIR=../../platform         # platform repo: the aicore endpoint map, and tools/bundle.py for offline kits
# AICORE_ENDPOINTS=                   # a copy of endpoints.generated.yaml, if not the platform's
# AI_HOST=localhost                   # `{name}` when Concord runs in a container on ai-net
# CATALOG_URL=http://127.0.0.1:8700   # the model catalog (or AICORE_CATALOG); http://catalog:8700 in a container
# CATALOG_UI_URL=                     # the catalog's UI, linked from the Models page (default: CATALOG_URL)
# PUBLIC_URL=http://127.0.0.1:8600    # where Concord Label reads Bench's outputs (registered with the catalog)
# REPLAY_DIR=fixtures/recorded        # serve recorded model responses (demo / tests without a GPU or catalog)
# RECORD_DIR=                         # write every live response here
# LABEL_URL=http://localhost:8620     # Concord Label: "Open in Label" and "Send flags to Label" (unset: no links)
